# Frontend runtime API origins.
# Example local values:
# VITE_API_BASE_URL=http://localhost:3000
# VITE_WEBSOCKET_BASE_URL=ws://localhost:3000
VITE_API_BASE_URL=
VITE_WEBSOCKET_BASE_URL=

# Canonical public website origin used by <SEO />.
# Production example: https://bonga.exirfirm.com
VITE_SITE_URL=

# Build-time sitemap generation. If SEO_API_BASE_URL is empty, the generator
# falls back to VITE_API_BASE_URL and then to the site origin + /api.
SEO_API_BASE_URL=
SEO_SITE_URL=
