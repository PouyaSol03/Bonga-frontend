{
  "name": "bonga-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "seo:generate": "node scripts/generate-seo-files.mjs",
    "prebuild": "npm run seo:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "audit:perf": "powershell -ExecutionPolicy Bypass -File ./scripts/run-sitespeed.ps1 -Mode representative",
    "audit:perf:all": "powershell -ExecutionPolicy Bypass -File ./scripts/run-sitespeed.ps1 -Mode all-public",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ad": "vitest run tests/unit/advertise",
    "test:storybook": "vitest run tests/unit/storybook",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "storybook": "storybook dev -p 6006 --host 192.168.1.242",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "firebase": "^12.18.0",
    "ky": "^2.0.2",
    "leaflet": "^1.9.4",
    "motion": "^12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.79.0",
    "react-is": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router": "^8.4.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "storybook": "^10.4.6",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
